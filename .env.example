# Environment configuration template for DarGlobal & Wasalt Chatbot
# Copy this file to .env and insert your API keys

# Google Gemini API key (for gemini-embedding-001 and chat fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Chat Model (used when OpenRouter quota is exhausted)
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite-preview

# OpenRouter API key (for Chat completions)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Configurable OpenRouter model
OPENROUTER_MODEL=openrouter/free

# Server Host and Port
HOST=0.0.0.0
PORT=8000
